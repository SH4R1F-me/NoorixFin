# =============================================================================
# NoorixFin Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Supabase — Local development (from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key  # NEVER expose to clients

# Supabase — JWT verification (NestJS verifies tokens LOCALLY — DEC-011)
# Newer Supabase projects sign with asymmetric keys and are verified via the
# JWKS endpoint at $SUPABASE_URL/auth/v1/.well-known/jwks.json — no secret
# needed, leave this blank. Legacy projects sign HS256 with a shared secret;
# set it here and the verifier falls back to it.
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase — Postgres connection (DEC-011)
# Use the SUPAVISOR TRANSACTION-MODE pooler URI (port 6543), not the direct
# connection (5432). Free Tier has a small direct-connection budget, and the API
# must not hold one Postgres connection per request.
# Format: postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=

# NestJS API
API_PORT=3001
# Comma-separated. Must be named CORS_ORIGINS — this is the name main.ts reads.
CORS_ORIGINS=http://localhost:3000

# Graceful shutdown. On SIGTERM the API reports 503 from /health/ready straight
# away, then keeps serving for DRAIN ms so the load balancer can stop routing
# to it, then closes (which flushes the buffered system-events writer).
# Set DRAIN a little above your platform's readiness poll interval.
SHUTDOWN_DRAIN_MS=5000
# Hard cap. If close() hangs past this, the process exits non-zero rather than
# leaving a deploy waiting for a grace period that will end in SIGKILL anyway.
SHUTDOWN_TIMEOUT_MS=25000

# Google OAuth (optional — DEC-016 profile settings / login)
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and add the Supabase callback as an authorised redirect URI:
#   local:  http://127.0.0.1:54321/auth/v1/callback
#   hosted: https://<project-ref>.supabase.co/auth/v1/callback
# These are consumed by supabase/config.toml via env() substitution.
# Leave blank to run without Google sign-in — the UI then shows an explicit
# "not configured" state rather than a button that errors at the provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Next.js Web (public variables prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
# Origin used to build OAuth and email-link redirect URLs. Must match a value in
# supabase/config.toml's additional_redirect_urls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" only once the Google credentials above are filled in.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Expo Mobile (public variables prefixed with EXPO_PUBLIC_)
# The device holds its session in SecureStore (DEC-010) — unlike web, which
# cannot hold a token at all (DEC-009, httpOnly cookies).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3001
# Dev-only shortcut until workspace selection is wired (see app/index.tsx TODO)

# Release identity (observability — @noorixfin/observability)
# Stamped onto every recorded error so "errors spiked at 14:00" can be joined to
# "we deployed at 13:58". Set by the build, not by a developer: APP_COMMIT is
# read from VERCEL_GIT_COMMIT_SHA or GITHUB_SHA automatically when either is
# present, so in CI you usually need neither of these.
APP_VERSION=
APP_COMMIT=
# Overrides NODE_ENV for reporting only — lets a staging deploy running
# NODE_ENV=production be labelled "staging" in the error feed.
APP_ENV=

# The web and mobile bundles cannot read the variables above: Next inlines only
# NEXT_PUBLIC_* and Expo only EXPO_PUBLIC_*. Set these so a browser or device
# error carries the SAME release string as a server one — without them the two
# halves of a bad deploy cannot be correlated.
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_COMMIT=
EXPO_PUBLIC_APP_VERSION=
EXPO_PUBLIC_APP_COMMIT=

# Node environment
NODE_ENV=development
