# =============================================================================
# NoorixFin Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Supabase — Local development (from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key  # NEVER expose to clients

# Supabase — JWT verification (NestJS verifies tokens LOCALLY — DEC-011)
# Newer Supabase projects sign with asymmetric keys and are verified via the
# JWKS endpoint at $SUPABASE_URL/auth/v1/.well-known/jwks.json — no secret
# needed, leave this blank. Legacy projects sign HS256 with a shared secret;
# set it here and the verifier falls back to it.
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase — Postgres connection (DEC-011)
# Use the SUPAVISOR TRANSACTION-MODE pooler URI (port 6543), not the direct
# connection (5432). Free Tier has a small direct-connection budget, and the API
# must not hold one Postgres connection per request.
# Format: postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=

# NestJS API
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# Next.js Web (public variables prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001

# Expo Mobile (public variables prefixed with EXPO_PUBLIC_)
# The device holds its session in SecureStore (DEC-010) — unlike web, which
# cannot hold a token at all (DEC-009, httpOnly cookies).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3001
# Dev-only shortcut until workspace selection is wired (see app/index.tsx TODO)
EXPO_PUBLIC_DEV_WORKSPACE_ID=

# Node environment
NODE_ENV=development
