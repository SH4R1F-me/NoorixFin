{
  "name": "@noorixfin/api-client",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "echo 'Consumed from source (main → src/index.ts); nothing to compile'",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm --filter @noorixfin/api openapi:generate && openapi-typescript openapi.json -o src/schema.d.ts",
    "check:fresh": "node scripts/check-fresh.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0"
  }
}
